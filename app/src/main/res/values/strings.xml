    <string name="clear">Clear</string>

    <!-- confirm dialogs -->
    <string name="confirm_install_title">Enable priv-app mode</string>
    <string name="confirm_install_body">Writes a KSU module to /data/adb/modules. It becomes active after a reboot.</string>
    <string name="confirm_remove_title">Remove priv-app mode</string>
    <string name="confirm_remove_body">The module is deleted at the next boot.</string>
    <string name="confirm_clear_body">Discards all samples and cell-change history.</string>
    <string name="confirm_reboot_body">Reboots the device.</string>
    <string name="exit_app">Exit</string>
    <string name="exit_body">Stops measuring, recording and the overlay, and closes the app.</string>
    <string name="cancel">Cancel</string>

    <!-- settings: radio -->
    <string name="group_radio">Radio</string>
    <string name="rat_lock">Network type</string>
    <string name="rat_lock_p1">Restricts which RATs the modem may camp on (allowed network types, user slot). The modem re-registers immediately.</string>
    <string name="rat_lock_p2">Band or cell locking is not possible on Tensor: Android has no API for it and Shannon lacks the DIAG path NSG uses on Qualcomm.</string>
    <string name="rat_lock_needs_privapp">Requires priv-app mode</string>
