    <!-- settings: measurement -->
    <string name="group_measure">Measurement</string>
    <string name="poll_interval">Update interval</string>
    <string name="poll_interval_p1">Calls requestCellInfoUpdate() at this interval and records one sample each time.</string>
    <string name="poll_interval_p2">Shorter tracks changes faster but costs modem load and battery. 1000 ms is a good default.</string>
    <string name="ping">Ping</string>
    <string name="ping_p1">Sends one ICMP echo per interval via /system/bin/ping. Falls back to TCP connect time to port 443 when ICMP is unavailable.</string>
    <string name="ping_p2">The Signal tab shows the RTT trend with min / avg / max / jitter / loss.</string>
    <string name="gnb_bits">gNB ID length</string>
    <string name="gnb_bits_p1">The NR NCI (36 bit) is gNB ID + cell ID; operators choose a gNB ID length between 22 and 32 bits.</string>
    <string name="gnb_bits_p2">24 is common in Japan and Europe, 22 in the US. A wrong value only shifts the gNB / cell split; the NCI itself is unaffected.</string>
    <string name="speed_server">Speed-test server</string>
    <string name="speed_server_hint">wss://…/ndt/v7</string>
    <string name="speed_server_p1">Leave empty to use the nearest M-Lab NDT7 server. A custom URL should be an ndt7 base (…/ndt/v7).</string>
    <string name="speed_server_p2">M-Lab publishes measurement results as open data (server, time, throughput). Nothing else from this app is sent.</string>
    <string name="speed_test">Speed test</string>
    <string name="speed_confirm_title">Speed test</string>
    <string name="speed_confirm_body">Transfers about 200–400 MB over the cellular link.</string>
    <string name="speed_locate">Locate</string>
    <string name="speed_download">Down</string>
    <string name="speed_upload">Up</string>
    <string name="speed_share_csv">Share CSV</string>
    <string name="speed_err_dns">DNS</string>
    <string name="more_speed">Speed tests</string>

    <!-- settings: display -->
    <string name="group_display">Display</string>
    <string name="pip_auto">PiP on Home</string>
    <string name="pip_auto_p1">Leaving with Home keeps the serving HUD in a picture-in-picture window.</string>
    <string name="pip_auto_p2">The header icon still opens PiP when this is off. Overlay on disables auto-enter so the two do not stack.</string>
    <string name="overlay">Overlay</string>
    <string name="overlay_p1">A draggable HUD stays above other apps. Android will ask for “Display over other apps”.</string>
    <string name="overlay_p2">Tap the HUD to switch serving / throughput. Drag to move. Overlay on turns off auto-PiP.</string>
    <string name="overlay_running">HUD</string>
    <string name="hud_cycle">Switch display</string>
    <string name="overlay_close">Close</string>

    <!-- settings: privilege -->
    <string name="group_privilege">Privilege</string>
    <string name="root_mode">Root mode</string>
    <string name="root_mode_p1">Reads dumpsys telephony.registry and logcat -b radio through su.</string>
    <string name="root_mode_p2">Adds PhysicalChannelConfig (PCC/SCC, bandwidth), IMS registration, NSA state and APN / IP / QoS of data calls.</string>
    <string name="root_mode_p3">Grant su to this app in KernelSU Manager.</string>
    <string name="privapp_mode">priv-app mode</string>
    <string name="privapp_mode_p1">Mounts this app into /system/priv-app as a KSU module, granting READ_PRIVILEGED_PHONE_STATE.</string>
    <string name="privapp_mode_p2">PhysicalChannelConfigListener then works event-driven (no dumpsys polling) and VoNR state becomes readable.</string>
    <string name="privapp_mode_p3">“Enable” writes the module to /data/adb/modules; it takes effect after a reboot. “Remove” deletes the module at the next boot.</string>
    <string name="privapp_active">active</string>
    <string name="privapp_pending_reboot">active after reboot</string>
    <string name="privapp_pending_removal">removed after reboot</string>
    <string name="privapp_inactive">inactive</string>
    <string name="privapp_enable">Enable</string>
    <string name="privapp_regenerate">Rewrite</string>
    <string name="privapp_reboot">Reboot</string>
    <string name="privapp_remove">Remove</string>
    <string name="check_su">Check su</string>

